#!/bin/bash
# 股权树生成器 Debug Launcher
# 双击这个文件会在终端中运行程序，崩溃时显示错误信息
DIR="$(cd "$(dirname "$0")" && pwd)"
echo "============================================"
echo " 股权树生成器 - Debug模式"
echo " 如果程序崩溃，错误信息将显示在这里"
echo "============================================"
echo ""
"$DIR/股权树生成器.app/Contents/MacOS/股权树生成器" 2>&1
echo ""
echo "============================================"
echo "程序已退出，按 Enter 关闭此窗口"
read